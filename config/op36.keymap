#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
        };

        hrdsgn {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
        };
    };

    macros {
        next_scr: next_scr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(RIGHT_ARROW)>;
            label = "NEXT_SCR";
        };

        prev_scr: prev_scr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT_ARROW)>;
            label = "PREV_SCR";
        };

        scr_lock: scr_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(RC(Q))>;
            label = "SCR_LOCK";
        };

        scr_unlock: scr_unlock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp A &kp R &kp I &kp Y &kp A &kp N0>;
            label = "SCR_UNLOCK";
        };

        prnt_scr: prnt_scr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(NUMBER_4))>;
            label = "PRNT_SCR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R          &kp T                          &kp Y  &kp U         &kp I         &kp O        &kp P
  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F   &kp G                          &kp H  &hmr RSHFT J  &hmr RCTRL K  &hmr LALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V          &kp B                          &kp N  &kp M         &kp COMMA     &kp DOT      &kp SQT
                                          &kp BACKSPACE  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp ESC
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
  &kp N1     &kp N2       &kp N3     &kp N4     &kp N5                    &kp N6     &kp N7           &kp N8           &kp N9            &kp N0
  &kp LGUI   &kp LALT     &kp LCTRL  &kp LSHFT  &kp F5                    &kp TAB    &hmr RSHFT LEFT  &hmr RCTRL DOWN  &hmr LALT UP      &hmr RGUI RIGHT
  &scr_lock  &scr_unlock  &kp F1     &kp F2     &kp F6                    &prev_scr  &next_scr        &kp BACKSLASH    &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                                     &trans     &trans  &trans    &trans  &mo 3      &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
  &kp TILDE               &kp GRAVE                &kp MINUS                    &kp UNDER        &kp SEMI                     &kp COMMA  &kp PLUS         &kp EQUAL               &kp PRCNT            &kp HASH
  &hml LGUI LEFT_BRACKET  &hml LALT RIGHT_BRACKET  &hml LCTRL LEFT_PARENTHESIS  &hml LSHFT RPAR  &kp COLON                    &kp DOT    &hmr RSHFT LBRC  &hmr RCTRL RIGHT_BRACE  &hmr LALT LESS_THAN  &hmr RGUI GREATER_THAN
  &kp AT_SIGN             &kp CARET                &kp BACKSLASH                &kp PIPE         &kp SLASH                    &kp QMARK  &kp EXCL         &kp ASTRK               &kp AMPS             &kp DLLR
                                                                                &trans           &mo 3      &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
  &bootloader  &kp F1        &kp F2         &kp F3         &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1       &none                &none               &bt BT_CLR
  &kp LGUI     &hml LALT F5  &hml LCTRL F6  &hml LSHFT F7  &kp F8                     &prnt_scr     &hmr RSHFT C_MUTE  &hmr RCTRL C_VOL_DN  &hmr LALT C_VOL_UP  &kp RGUI
  &none        &kp F9        &kp F10        &kp F11        &kp F12                    &none         &kp C_PREV         &kp C_PP             &kp C_NEXT          &none
                                            &trans         &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
